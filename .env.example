# Copy to .env.local and fill in. NEXT_PUBLIC_* values are inlined at build
# time, so after changing one in Vercel you must redeploy.

# ── Analytics ────────────────────────────────────────────────────────────────
# GA4 measurement ID (Admin → Data streams → Web). GA loads only in production
# builds and never on /admin.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Bing Webmaster Tools verification (optional)
NEXT_PUBLIC_BING_VERIFICATION=

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
# At least 32 random characters
SESSION_SECRET=
# Bearer key for POST /api/posts/create-draft
DRAFT_API_KEY=

# ── Contact form ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Media and AI ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
